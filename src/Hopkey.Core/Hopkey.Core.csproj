<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Hopkey.Core</RootNamespace>
    <IsTrimmable>false</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hopkey.SelfTest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Char → pinyin table (mozillazg/pinyin-data, MIT); regenerate with tools/gen-pinyin.cs -->
    <EmbeddedResource Include="Pinyin\pinyin-data.txt" LogicalName="Hopkey.Core.Pinyin.pinyin-data.txt" />
    <None Include="Pinyin\pinyin-data.LICENSE.txt" />
  </ItemGroup>

</Project>
