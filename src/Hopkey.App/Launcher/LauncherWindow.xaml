<Window x:Class="Hopkey.App.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hopkey.App.Launcher"
        Title="Hopkey" Width="680" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Left="-10000" Top="-10000"
        Background="{DynamicResource Brush.Card}" Foreground="{DynamicResource Brush.Text}"
        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
        FontFamily="{DynamicResource Font.Family}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="8,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:ResultItemViewModel}">
            <Grid Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" VerticalAlignment="Center" HorizontalAlignment="Left"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock local:HighlightText.Item="{Binding}" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Brush.SubText}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Shortcut}" FontSize="11" Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ActionTemplate" DataType="{x:Type local:ActionItemViewModel}">
            <Grid Height="36">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Shortcut}" FontSize="11" Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Context tag -->
        <Border Grid.Row="0" Visibility="{Binding IsContextMode, Converter={StaticResource BoolToVis}}"
                Background="{DynamicResource Brush.Selected}" Padding="14,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ContextText}" Margin="8,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Query -->
        <Grid Grid.Row="1" Height="52" Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                       Foreground="{DynamicResource Brush.SubText}" VerticalAlignment="Center" Margin="2,0,10,0" />
            <TextBlock Grid.Column="1" Text="{DynamicResource S.Launcher.Placeholder}" FontSize="20" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.SubText}" IsHitTestVisible="False" Margin="3,0,0,0"
                       x:Name="Placeholder" />
            <TextBox Grid.Column="1" x:Name="QueryBox" FontSize="20" VerticalAlignment="Center" BorderThickness="0"
                     Background="Transparent" Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Text}"
                     Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnQueryTextChanged" />
        </Grid>

        <Rectangle Grid.Row="2" Height="1" Fill="{DynamicResource Brush.Border}" VerticalAlignment="Top" />

        <!-- Results / actions -->
        <Grid Grid.Row="2" Margin="0,4,0,4">
            <ListBox x:Name="ResultList" ItemsSource="{Binding Results}" SelectedIndex="{Binding SelectedIndex}"
                     ItemTemplate="{StaticResource ResultTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"
                     BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}" MaxHeight="430"
                     Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Item"
                     MouseDoubleClick="OnResultDoubleClick" />
            <StackPanel x:Name="ActionPanel" Visibility="{Binding ActionMode, Converter={StaticResource BoolToVis}}"
                        Background="{DynamicResource Brush.Card}">
                <TextBlock Text="{DynamicResource S.Launcher.Back}" Margin="16,4" FontSize="11" Foreground="{DynamicResource Brush.SubText}" />
                <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedIndex="{Binding SelectedActionIndex}"
                         ItemTemplate="{StaticResource ActionTemplate}" ItemContainerStyle="{StaticResource ResultItemStyle}"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Brush.Text}" Focusable="False"
                         MouseDoubleClick="OnActionDoubleClick" MouseLeftButtonUp="OnActionDoubleClick" />
            </StackPanel>
            <TextBlock x:Name="EmptyHint" Text="{DynamicResource S.Launcher.EmptyHint}" Margin="16,14" Foreground="{DynamicResource Brush.SubText}"
                       Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVis}}" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="4" Height="26" Background="{DynamicResource Brush.CardAlt}" Padding="14,0">
            <Grid>
                <TextBlock x:Name="StatusText" Text="{Binding IndexStatus}" FontSize="11" VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.SubText}" MouseLeftButtonUp="OnStatusClick" />
                <TextBlock Text="{Binding Message}" FontSize="11" VerticalAlignment="Center" Margin="200,0,0,0"
                           Foreground="{DynamicResource Brush.Accent}" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding KeyHints}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource Brush.SubText}" />
            </Grid>
        </Border>
    </Grid>
</Window>
