<!-- "Arc & Keycap" QuickSwitch toolbar — see docs/UI-REDESIGN.md §7 -->
<Window x:Class="Hopkey.App.QuickSwitch.QuickSwitchToolbar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hopkey QuickSwitch"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False"
        SizeToContent="WidthAndHeight" Background="{DynamicResource Brush.Card}"
        BorderBrush="{DynamicResource Brush.PlateEdge}" BorderThickness="0"
        FontFamily="{DynamicResource Font.Family}" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="TbButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Selected}" />
                                <Setter TargetName="Bd" Property="RenderTransform"><Setter.Value><TranslateTransform Y="1" /></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Icon}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid>
        <Rectangle Height="2" VerticalAlignment="Top" Fill="{DynamicResource Brush.Hop}" IsHitTestVisible="False" />
        <Border Padding="4,6,4,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="SearchButton" Style="{StaticResource TbButton}" Background="{DynamicResource Brush.AccentSoft}"
                        ToolTip="{DynamicResource S.QS.Search}" Click="OnSearch">
                    <Path Width="16" Height="11" Stretch="Uniform" Data="M94,132 Q128,84 162,132 M146,128 L162,134 L168,116"
                          Stroke="{DynamicResource Brush.Hop}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Button>
                <Button x:Name="RecommendButton" Style="{StaticResource TbButton}" ToolTip="{DynamicResource S.QS.Recommended}"
                        Click="OnRecommend" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Glyph}" FontSize="13" Text="&#xE8B7;" Foreground="{DynamicResource Brush.Accent}" />
                        <TextBlock x:Name="RecommendText" Margin="6,0,0,0" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Height="18" Margin="4,0" Fill="{DynamicResource Brush.Divider}" VerticalAlignment="Center" />
                <Button x:Name="ExplorerButton" Style="{StaticResource TbButton}" ToolTip="{DynamicResource S.QS.OpenFolders}" Click="OnExplorerMenu">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xEC50;" />
                </Button>
                <Button x:Name="FavoritesButton" Style="{StaticResource TbButton}" ToolTip="{DynamicResource S.QS.Favorites}" Click="OnFavoritesMenu">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE734;" />
                </Button>
                <Button x:Name="RecentButton" Style="{StaticResource TbButton}" ToolTip="{DynamicResource S.QS.Recent}" Click="OnRecentMenu">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE81C;" />
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource TbButton}" ToolTip="{DynamicResource S.QS.More}" Click="OnMoreMenu">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE712;" />
                </Button>
                <Button x:Name="WarningButton" Style="{StaticResource TbButton}" Background="{DynamicResource Brush.WarningSoft}"
                        ToolTip="{DynamicResource S.QS.ElevatedHint}" Click="OnWarning" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Brush.Warning}" />
                </Button>
                <Grid x:Name="BusyIndicator" Width="16" Height="16" Margin="6,0" Visibility="Collapsed" VerticalAlignment="Center">
                    <Ellipse Stroke="{DynamicResource Brush.Divider}" StrokeThickness="2" />
                    <Ellipse x:Name="Spinner" Stroke="{DynamicResource Brush.Hop}" StrokeThickness="2" StrokeDashArray="6 20" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
