<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Hopkey</AssemblyName>
    <RootNamespace>Hopkey.App</RootNamespace>
    <StartupObject>Hopkey.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Source artwork + generator: assets/icon (python assets/icon/build_icon.py) -->
    <ApplicationIcon>Assets\hopkey.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Performance: precompiled code + dynamic PGO; workstation concurrent GC for a resident desktop app -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>true</TieredPGO>
    <TieredCompilation>true</TieredCompilation>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFO0003: DPI awareness is declared in app.manifest on purpose (WPF host, PerMonitorV2) -->
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416;WFO0003</NoWarn>
    <Version>0.4.0</Version>
    <Product>Hopkey</Product>
  </PropertyGroup>

  <ItemGroup>
    <!-- Resident app: prefer compacting/decommitting over peak throughput -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
    <RuntimeHostConfigurationOption Include="System.GC.RetainVM" Value="false" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <EmbeddedResource Include="Assets\hopkey.ico" LogicalName="Hopkey.App.Assets.hopkey.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Hopkey.Core\Hopkey.Core.csproj" />
  </ItemGroup>

</Project>
