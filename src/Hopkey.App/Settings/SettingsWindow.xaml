<!-- "Arc & Keycap" settings — see docs/UI-REDESIGN.md §8 -->
<Window x:Class="Hopkey.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Hopkey.App.Settings"
        Title="{DynamicResource S.Settings.Title}" Width="900" Height="640" MinWidth="720" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Text}"
        FontFamily="{DynamicResource Font.Family}" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Hopkey;component/Themes/SettingsControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <TabControl x:Name="Tabs" Style="{StaticResource Hk.NavTabs}">

            <!-- ======================== General ======================== -->
            <TabItem Header="{DynamicResource S.Settings.General}" Tag="&#xE713;">
                <ScrollViewer Style="{StaticResource Hk.Page}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource Hk.PageTitle}" Text="{DynamicResource S.Settings.General}" />

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource S.Settings.Autostart}" IsChecked="{Binding Autostart}" />
                                <Border Style="{StaticResource Hk.SubGroup}">
                                    <CheckBox Content="{DynamicResource S.Settings.AutostartElevated}" IsChecked="{Binding AutostartElevated}"
                                              IsEnabled="{Binding CanAutostartElevated}" Margin="0,4" />
                                </Border>
                                <Rectangle Height="1" Margin="-20,10" Fill="{DynamicResource Brush.Divider}" />
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Style="{StaticResource Hk.Label}" Text="{DynamicResource S.Settings.Language}" />
                                    <ComboBox Width="220" ItemsSource="{Binding Languages}" DisplayMemberPath="Display"
                                              SelectedValuePath="Value" SelectedValue="{Binding Language}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,2">
                                    <TextBlock Style="{StaticResource Hk.Label}" Text="{DynamicResource S.Settings.Theme}" />
                                    <ComboBox Width="220" ItemsSource="{Binding Themes}" DisplayMemberPath="Display"
                                              SelectedValuePath="Value" SelectedValue="{Binding Theme}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.LauncherHotkey}" />
                                <StackPanel Orientation="Horizontal">
                                    <!-- No GroupName: named groups are process-wide in WPF, so a closed (not yet collected) Settings
                                         window's radios would join this group and ping-pong with ours until the stack overflows.
                                         Siblings in the same panel are grouped by parent, which is per window. -->
                                    <Border Style="{StaticResource Hk.SegmentHost}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Hk.Segment}" Content="{DynamicResource S.Settings.DoubleCtrl}" IsChecked="{Binding LauncherDoubleCtrl}" />
                                            <RadioButton Style="{StaticResource Hk.Segment}" Content="{DynamicResource S.Settings.Combination}" IsChecked="{Binding LauncherCombination}" />
                                        </StackPanel>
                                    </Border>
                                    <local:HotkeyBox Hotkey="{Binding LauncherCombo}" IsEnabled="{Binding LauncherCombination}" Margin="12,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Hk.Label}" Text="{DynamicResource S.Settings.AltHotkey}" />
                                    <local:HotkeyBox Hotkey="{Binding LauncherAlt}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{DynamicResource S.Settings.HotkeyHint}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding HotkeyError}" Foreground="{DynamicResource Brush.Error}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Rectangle Height="1" Margin="-20,8,-20,6" Fill="{DynamicResource Brush.Divider}" />
                                <CheckBox Content="{DynamicResource S.Settings.TypeToSearch}" IsChecked="{Binding TypeToSearch}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Search}" />
                                <CheckBox Content="{DynamicResource S.Settings.Search.Pinyin}" IsChecked="{Binding Pinyin}" />
                                <CheckBox Content="{DynamicResource S.Settings.Search.HistoryBoost}" IsChecked="{Binding HistoryBoost}" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource Hk.Label}" Text="{DynamicResource S.Settings.Search.MaxResults}" />
                                    <TextBox Width="80" Text="{Binding MaxResults, UpdateSourceTrigger=LostFocus}" />
                                    <Button Content="{DynamicResource S.Settings.Search.ClearHistory}" Margin="16,0,0,0" Click="OnClearHistory" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hk.SubTitle}" Text="{DynamicResource S.Settings.Search.ShowDetails}" />
                                <WrapPanel>
                                    <CheckBox Content="{DynamicResource S.Settings.Search.ShowCreated}" IsChecked="{Binding ShowCreated}" Margin="0,4,24,4" />
                                    <CheckBox Content="{DynamicResource S.Settings.Search.ShowModified}" IsChecked="{Binding ShowModified}" Margin="0,4,24,4" />
                                    <CheckBox Content="{DynamicResource S.Settings.Search.ShowSize}" IsChecked="{Binding ShowSize}" Margin="0,4,24,4" />
                                </WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Style="{StaticResource Hk.Label}" Text="{DynamicResource S.Settings.Search.SortBy}" />
                                    <ComboBox Width="220" ItemsSource="{Binding SortModes}" DisplayMemberPath="Display"
                                              SelectedValuePath="Value" SelectedValue="{Binding SortBy}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{DynamicResource S.Settings.Search.SortHint}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Privilege}" />
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding PrivilegeText}" />
                                <Button x:Name="ElevateButton" Style="{StaticResource Hk.Button.Primary}" Content="{DynamicResource S.Tray.RunAsAdmin}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRestartElevated" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================== QuickSwitch ======================== -->
            <TabItem Header="{DynamicResource S.Settings.QuickSwitch}" Tag="&#xE8AB;">
                <ScrollViewer Style="{StaticResource Hk.Page}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource Hk.PageTitle}" Text="{DynamicResource S.Settings.QuickSwitch}" />
                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <CheckBox Content="{DynamicResource S.Settings.QS.Enabled}" IsChecked="{Binding QsEnabled}" FontWeight="SemiBold" />
                                <Border Style="{StaticResource Hk.SubGroup}" Margin="19,4,0,4">
                                    <StackPanel IsEnabled="{Binding QsEnabled}">
                                        <CheckBox Content="{DynamicResource S.Settings.QS.ShowToolbar}" IsChecked="{Binding QsShowToolbar}" />
                                        <CheckBox Content="{DynamicResource S.Settings.QS.Follow}" IsChecked="{Binding QsFollow}" />
                                        <CheckBox Content="{DynamicResource S.Settings.QS.AutoOnOpen}" IsChecked="{Binding QsAutoOnOpen}" />
                                        <Border Style="{StaticResource Hk.SubGroup}" Margin="19,2,0,6">
                                            <StackPanel Orientation="Horizontal" Margin="0,2" IsEnabled="{Binding QsAutoOnOpen}">
                                                <TextBlock Text="{DynamicResource S.Settings.QS.MaxAge}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <TextBox Width="70" Text="{Binding QsMaxAge, UpdateSourceTrigger=LostFocus}" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="{DynamicResource S.Settings.QS.DialogJump}" IsChecked="{Binding QsDialogJump}" VerticalAlignment="Center" />
                                            <local:HotkeyBox Hotkey="{Binding DialogJump}" Margin="16,0,0,0" IsEnabled="{Binding QsDialogJump}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}" IsEnabled="{Binding QsEnabled}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.QS.DisabledApps}" />
                                <TextBox Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                         Text="{Binding QsDisabledApps, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}" IsEnabled="{Binding QsEnabled}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.QS.AutoExcludedApps}" />
                                <TextBox Height="80" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                         FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                         Text="{Binding QsAutoExcludedApps, UpdateSourceTrigger=LostFocus}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================== Index & Exclusions ======================== -->
            <TabItem Header="{DynamicResource S.Settings.Index}" Tag="&#xE71C;">
                <ScrollViewer Style="{StaticResource Hk.Page}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource Hk.PageTitle}" Text="{DynamicResource S.Settings.Index}" />

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Index.Roots}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.AllDrives}" IsChecked="{Binding AllDrives}" />
                                <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                                        Background="{DynamicResource Brush.Input}" Padding="4" Margin="0,6,0,0">
                                    <ListBox x:Name="RootsList" ItemsSource="{Binding Roots}" Height="76" Background="Transparent"
                                             BorderThickness="0" Foreground="{DynamicResource Brush.Text}"
                                             ItemContainerStyle="{StaticResource Hk.ListItem}" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="{DynamicResource S.Settings.Index.AddFolder}" Click="OnAddRoot" />
                                    <Button Content="{DynamicResource S.Remove}" Click="OnRemoveRoot" />
                                </StackPanel>
                                <Rectangle Height="1" Margin="-20,14,-20,6" Fill="{DynamicResource Brush.Divider}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.UseUsn}" IsChecked="{Binding UseUsn}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.Apps}" IsChecked="{Binding IndexApps}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.Uwp}" IsChecked="{Binding IndexUwp}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Index.Status}" />
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding IndexStatusText}" />
                                <Button Style="{StaticResource Hk.Button.Primary}" Content="{DynamicResource S.RebuildIndex}"
                                        HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnRebuild" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Index.Exclusions}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.ExcludeHidden}" IsChecked="{Binding ExcludeHidden}" />
                                <CheckBox Content="{DynamicResource S.Settings.Index.ExcludeSystem}" IsChecked="{Binding ExcludeSystem}" />
                                <DataGrid x:Name="RulesGrid" ItemsSource="{Binding Rules}" Height="260" Margin="0,8,0,0">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="{DynamicResource S.Settings.Index.Col.Enabled}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="56"
                                                                ElementStyle="{StaticResource Hk.GridCheck}" EditingElementStyle="{StaticResource Hk.GridCheck}" />
                                        <DataGridComboBoxColumn x:Name="KindColumn" Header="{DynamicResource S.Settings.Index.Col.Kind}" Width="100"
                                                                SelectedValueBinding="{Binding Kind}" SelectedValuePath="Value" DisplayMemberPath="Display" />
                                        <DataGridTextColumn Header="{DynamicResource S.Settings.Index.Col.Pattern}" Binding="{Binding Pattern}" Width="*"
                                                            EditingElementStyle="{StaticResource Hk.GridEdit}" />
                                        <DataGridComboBoxColumn x:Name="TargetColumn" Header="{DynamicResource S.Settings.Index.Col.Target}" Width="120"
                                                                SelectedValueBinding="{Binding Target}" SelectedValuePath="Value" DisplayMemberPath="Display" />
                                        <DataGridTextColumn Header="{DynamicResource S.Settings.Index.Col.BuiltIn}" Binding="{Binding BuiltInText}" Width="56" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding RuleErrors}" Foreground="{DynamicResource Brush.Error}" TextWrapping="Wrap" />
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="{DynamicResource S.Settings.Index.AddFolder}" Click="OnAddExcludeFolder" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Settings.Index.AddName}" Click="OnAddExcludeName" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Settings.Index.AddGlob}" Click="OnAddExcludeGlob" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Settings.Index.AddRegex}" Click="OnAddExcludeRegex" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Remove}" Click="OnRemoveRule" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Import}" Click="OnImportRules" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.Export}" Click="OnExportRules" Margin="0,0,8,8" />
                                    <Button Content="{DynamicResource S.RestoreDefaults}" Click="OnRestoreRules" Margin="0,0,8,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ======================== Favorites ======================== -->
            <TabItem Header="{DynamicResource S.Settings.Favorites}" Tag="&#xE734;">
                <Grid Margin="32,28,32,32" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hk.PageTitle}" Text="{DynamicResource S.Settings.Favorites}" />
                    <Border Grid.Row="1" Style="{StaticResource Hk.Section}" Padding="8,4" Margin="0">
                        <DataGrid x:Name="FavoritesGrid" ItemsSource="{Binding Favorites}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{DynamicResource S.Settings.Fav.Alias}" Binding="{Binding Alias}" Width="160"
                                                    EditingElementStyle="{StaticResource Hk.GridEdit}" />
                                <DataGridTextColumn Header="{DynamicResource S.Settings.Fav.Path}" Binding="{Binding Path}" Width="*"
                                                    EditingElementStyle="{StaticResource Hk.GridEdit}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                        <Button Content="{DynamicResource S.Settings.Fav.AddFolder}" Click="OnAddFavFolder" />
                        <Button Content="{DynamicResource S.Settings.Fav.AddFile}" Click="OnAddFavFile" />
                        <Button Content="{DynamicResource S.Remove}" Click="OnRemoveFav" />
                        <Button Content="{DynamicResource S.MoveUp}" Click="OnFavUp" />
                        <Button Content="{DynamicResource S.MoveDown}" Click="OnFavDown" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ======================== Web search ======================== -->
            <TabItem Header="{DynamicResource S.Settings.WebSearch}" Tag="&#xE774;">
                <Grid Margin="32,28,32,32" MaxWidth="760" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Hk.PageTitle}" Text="{DynamicResource S.Settings.WebSearch}" />
                    <Border Grid.Row="1" Style="{StaticResource Hk.Section}" Padding="8,4" Margin="0">
                        <DataGrid x:Name="WebGrid" ItemsSource="{Binding WebEngines}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="{DynamicResource S.Settings.Index.Col.Enabled}" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="56"
                                                        ElementStyle="{StaticResource Hk.GridCheck}" EditingElementStyle="{StaticResource Hk.GridCheck}" />
                                <DataGridTextColumn Header="{DynamicResource S.Settings.Web.Keyword}" Binding="{Binding Keyword}" Width="80"
                                                    EditingElementStyle="{StaticResource Hk.GridEdit}" />
                                <DataGridTextColumn Header="{DynamicResource S.Settings.Web.Name}" Binding="{Binding Name}" Width="110"
                                                    EditingElementStyle="{StaticResource Hk.GridEdit}" />
                                <DataGridTextColumn Header="{DynamicResource S.Settings.Web.Url}" Binding="{Binding UrlTemplate}" Width="*"
                                                    EditingElementStyle="{StaticResource Hk.GridEdit}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding WebError}" Foreground="{DynamicResource Brush.Error}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Content="{DynamicResource S.Add}" Click="OnAddWeb" />
                        <Button Content="{DynamicResource S.Remove}" Click="OnRemoveWeb" />
                        <Button Content="{DynamicResource S.RestoreDefaults}" Click="OnRestoreWeb" />
                    </WrapPanel>
                </Grid>
            </TabItem>

            <!-- ======================== About ======================== -->
            <TabItem Header="{DynamicResource S.Settings.About}" Tag="&#xE946;">
                <ScrollViewer Style="{StaticResource Hk.Page}">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Stretch">
                        <Border Style="{StaticResource Hk.Section}" Padding="24,22">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image Source="{DynamicResource Img.Logo}" Width="64" Height="64" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                                    <TextBlock Text="Hopkey" FontFamily="{DynamicResource Font.Numeric}" FontSize="30" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{DynamicResource S.Settings.About.Version}" Margin="0,0,8,0" Foreground="{DynamicResource Brush.SubText}" />
                                        <TextBlock Text="{Binding Version}" FontFamily="{DynamicResource Font.Mono}" Foreground="{DynamicResource Brush.SubText}" />
                                    </StackPanel>
                                    <Path Width="120" Height="3" Margin="0,12,0,0" HorizontalAlignment="Left" Stretch="Fill"
                                          Data="M0,0 H1" Stroke="{DynamicResource Brush.Hop}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                    <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding DataDirectory}" Margin="0,12,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource S.Onboarding.Open}" Style="{StaticResource Hk.Button.Primary}" Click="OnOpenGuide" />
                                        <Button Content="{DynamicResource S.Settings.About.DataDir}" Click="OnOpenDataDir" />
                                        <Button Content="{DynamicResource S.Settings.About.LogDir}" Click="OnOpenLogDir" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Update}" />
                                <CheckBox Content="{DynamicResource S.Settings.Update.Auto}" IsChecked="{Binding CheckForUpdates}" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource S.Settings.Update.Check}" Click="OnCheckUpdates" />
                                    <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding UpdateStatus}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.UserData}" />
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{DynamicResource S.Settings.UserData.Hint}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="{DynamicResource S.Settings.UserData.Export}" Click="OnExportUserData" />
                                    <Button Content="{DynamicResource S.Settings.UserData.Import}" Click="OnImportUserData" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.Index.Status}" />
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding IndexStatusText}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Hk.Section}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hk.SectionTitle}" Text="{DynamicResource S.Settings.About.Perf}" />
                                <TextBlock Style="{StaticResource Hk.Hint}" Text="{Binding PerfSummary}" FontFamily="{DynamicResource Font.Mono}" FontSize="11" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Hk.Hint}" Text="{DynamicResource S.Settings.About.License}" Margin="4,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- "Saved" pill floating over the page -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,20" CornerRadius="14" Padding="12,5"
                Background="{DynamicResource Brush.AccentSoft}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SavedText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding SavedText}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE73E;" FontFamily="{DynamicResource Font.Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SavedText}" Margin="6,0,0,0" Foreground="{DynamicResource Brush.Accent}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
